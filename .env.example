# Myjiefun Wedding Guest & Seating Manager
# Use a dedicated Supabase/Vercel project for this app only.

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://myjiefun.com

# Supabase project: myjiefun
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for scripts/seed.ts and trusted server maintenance tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local Supabase CLI metadata.
SUPABASE_PROJECT_ID=myjiefun
